[Unit]
PartOf=smartdev-operator.socket
Description=SmartDev DEV outbound operator connector
Wants=network-online.target
After=network-online.target smartdev-operator.socket
Requires=smartdev-operator.socket

[Service]
EnvironmentFile=/etc/smartdev-operator/outbound.conf
LoadCredential=machine-token:/etc/smartdev-operator/machine-token
ExecStart=/usr/bin/python3 -I /usr/local/lib/smartdev-operator/outbound.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
