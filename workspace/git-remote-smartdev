#!/usr/bin/env python3
"""Git's read-only remote helper for an enrolled workspace repository."""
import json, os, socket, sys, threading
def main():
    repository=sys.argv[2].removeprefix("smartdev::").removesuffix(".git")
    for line in sys.stdin.buffer:
        cmd=line.strip()
        if cmd==b"capabilities":
            sys.stdout.buffer.write(b"connect\n\n");sys.stdout.buffer.flush()
        elif cmd==b"connect git-upload-pack":
            with socket.socket(socket.AF_UNIX) as sock:
                sock.connect("/run/command-memory/tools.sock")
                sock.sendall((json.dumps({"action":"git-read","repository":repository})+"\n").encode())
                answer=b""
                while len(answer)<180 and not answer.endswith(b"\n"):
                    piece=sock.recv(1)
                    if not piece:break
                    answer+=piece
                if answer!=b"OK\n":raise RuntimeError("Project Git read access unavailable")
                sys.stdout.buffer.write(b"\n");sys.stdout.buffer.flush()
                def upload():
                    try:
                        while data:=os.read(0,65536): sock.sendall(data)
                        sock.shutdown(socket.SHUT_WR)
                    except OSError:pass
                threading.Thread(target=upload,daemon=True).start()
                while data:=sock.recv(65536):
                    sys.stdout.buffer.write(data);sys.stdout.buffer.flush()
                return
        else:raise RuntimeError("Only Git fetch and pull are available through this connection")
if __name__=="__main__":
    try:main()
    except (ValueError,OSError,RuntimeError) as e:sys.exit(str(e))
