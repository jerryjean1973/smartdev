#!/usr/bin/env python3
"""Run Claude Code non-interactively and normalize its stream for SmartDev chat."""
import argparse
import json
import subprocess
import sys
from uuid import UUID, uuid4


def emit(value):
    print(json.dumps(value, ensure_ascii=False), flush=True)


def item_type(block):
    name = block.get("name", "")
    data = block.get("input") or {}
    if name == "Bash":
        return {"id": block.get("id"), "type": "command_execution", "command": data.get("command", "")}
    if name in {"Edit", "Write", "NotebookEdit"}:
        return {"id": block.get("id"), "type": "file_change", "path": data.get("file_path") or data.get("notebook_path") or ""}
    return {"id": block.get("id"), "type": "tool_execution", "name": name}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", required=True)
    parser.add_argument("--resume")
    parser.add_argument("--session-id")
    parser.add_argument("--mcp-config")
    args = parser.parse_args()
    prompt = sys.stdin.read()
    session = args.resume or args.session_id or str(uuid4())
    try:
        session = str(UUID(session))
    except ValueError:
        sys.stderr.write("Claude Code session IDs must be UUIDs.\n")
        return 2
    command = [
        "claude", "-p", prompt, "--output-format", "stream-json", "--verbose",
        "--forward-subagent-text", "--permission-prompts", "none",
        "--permission-mode", "bypassPermissions" if args.mode == "workspace-write" else "plan",
    ]
    if args.resume:
        command.extend(["--resume", session])
    else:
        command.extend(["--session-id", session])
    if args.mcp_config:
        command.extend(["--strict-mcp-config", "--mcp-config", args.mcp_config])

    tools = {}
    last_text = None
    started = False
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=None, text=True, bufsize=1)
    assert process.stdout is not None
    for line in process.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            print(line.rstrip(), file=sys.stderr, flush=True)
            continue
        event_session = event.get("session_id") or (event.get("message") or {}).get("session_id")
        if event_session:
            try:
                session = str(UUID(event_session))
            except ValueError:
                pass
        if not started:
            emit({"type": "thread.started", "thread_id": session, "agent": "claude_code"})
            emit({"type": "turn.started"})
            started = True
        if event.get("type") == "assistant":
            for block in (event.get("message") or {}).get("content", []):
                if block.get("type") == "text" and block.get("text"):
                    last_text = block["text"]
                    emit({"type": "item.completed", "item": {"type": "agent_message", "text": last_text}})
                elif block.get("type") == "thinking":
                    emit({"type": "item.completed", "item": {"type": "reasoning", "text": block.get("thinking", "")}})
                elif block.get("type") == "tool_use":
                    normalized = item_type(block)
                    tools[block.get("id")] = normalized
                    emit({"type": "item.started", "item": normalized})
        elif event.get("type") == "user":
            for block in (event.get("message") or {}).get("content", []):
                if block.get("type") == "tool_result":
                    normalized = dict(tools.pop(block.get("tool_use_id"), {"id": block.get("tool_use_id"), "type": "tool_execution"}))
                    normalized["status"] = "failed" if block.get("is_error") else "completed"
                    if normalized.get("type") == "command_execution":
                        normalized["exit_code"] = 1 if block.get("is_error") else 0
                    emit({"type": "item.completed", "item": normalized})
        elif event.get("type") == "result":
            result = event.get("result")
            if isinstance(result, str) and result and result != last_text:
                emit({"type": "item.completed", "item": {"type": "agent_message", "text": result}})
            emit({"type": "turn.completed", "usage": event.get("usage"), "cost_usd": event.get("total_cost_usd"),
                  "status": "failed" if event.get("is_error") else "completed"})
    code = process.wait()
    if not started:
        emit({"type": "thread.started", "thread_id": session, "agent": "claude_code"})
    return code


if __name__ == "__main__":
    raise SystemExit(main())
