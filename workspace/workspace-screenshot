#!/usr/bin/env node
'use strict';
const fs=require('node:fs/promises'), path=require('node:path'), crypto=require('node:crypto');
const {spawn}=require('node:child_process');
const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
const args=process.argv.slice(2);
function option(name) {
  const explicit=args.find(v=>v.startsWith(name+'='));
  if(explicit) return explicit.slice(name.length+1);
  const index=args.indexOf(name);
  if(index<0) return;
  const value=args[index+1];
  if(value && !value.startsWith('--') && !/^https?:\/\//.test(value)) return value;
  if(name!=='--screenshot') throw Error('Missing value for '+name);
}
const url=args.find(v=>/^https?:\/\//.test(v));
const output=option('--out')||option('--screenshot')||'screenshot.png';
const selector=option('--selector'), expected=option('--text');
const [width,height]=(option('--window-size')||'1440,900').split(',').map(Number);
const endpoint='http://127.0.0.1:19222';
async function browserVersion(){const r=await fetch(endpoint+'/json/version',{signal:AbortSignal.timeout(2000)});if(!r.ok)throw Error('Workspace browser unavailable');return r.json()}
async function capture(){
  let own,profile,ws,context;
  let currentEndpoint=endpoint;
  try {
    let version;
    try {await fs.access('/run/command-memory/tools.sock');
      await require('node:util').promisify(require('node:child_process').execFile)('/usr/local/bin/workspace-browser-start',[],{timeout:20000});
    } catch (error) {if(error.code!=='ENOENT') throw error}

    try {version=await browserVersion()} catch(e){
      const native='/usr/bin/chromium';
      await fs.access(native).catch(()=>{throw Error('Workspace browser is unavailable. Check the workspace tools service.')});
      profile=await fs.mkdtemp('/tmp/cc-capture-');
      own=spawn(native,['--headless','--disable-dev-shm-usage','--disable-gpu','--no-first-run','--remote-debugging-port=0','--user-data-dir='+profile,'about:blank'],{stdio:'ignore'});
      for(let i=0;i<80;i++){try{const port=(await fs.readFile(profile+'/DevToolsActivePort','utf8')).split('\n')[0];currentEndpoint='http://127.0.0.1:'+port;version=await (await fetch(currentEndpoint+'/json/version')).json();break}catch{await wait(100)}}
      if(!version)throw Error('Chromium failed to start its sandbox.');
    }
    if(args.includes('--version')){console.log(version.Browser);return}
    if(!url||!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1||width>4096||height>4096)throw Error('Usage: screenshot URL --out FILE.png [--selector CSS] [--text TEXT] [--login] [--publish]');
    const targetUrl=new URL(url);if(targetUrl.username||targetUrl.password)throw Error('URL credentials are unsupported');
    ws=new WebSocket(version.webSocketDebuggerUrl);
    await new Promise((ok,fail)=>{ws.onopen=ok;ws.onerror=fail});
    let seq=0,session,documentStatus=0,mainFrame;
    const replies=new Map(),responses=new Map();
    ws.onmessage=({data})=>{
      const msg=JSON.parse(data);
      if(msg.id){const f=replies.get(msg.id);if(f){replies.delete(msg.id);msg.error?f.reject(Error(msg.error.message)):f.resolve(msg.result)}}
      if(msg.sessionId===session && msg.method==='Network.responseReceived' && msg.params.type==='Document'){
        responses.set(msg.params.frameId,msg.params.response.status);if(msg.params.frameId===mainFrame)documentStatus=msg.params.response.status;
      }
    };
    const send=(method,params={},sessionId)=>new Promise((resolve,reject)=>{const id=++seq;replies.set(id,{resolve,reject});ws.send(JSON.stringify({id,method,params,sessionId}))});
    context=(await send('Target.createBrowserContext',{disposeOnDetach:true})).browserContextId;
    const {targetId}=await send('Target.createTarget',{url:'about:blank',browserContextId:context});
    session=(await send('Target.attachToTarget',{targetId,flatten:true})).sessionId;
    const call=(method,params={})=>send(method,params,session);
    await call('Page.enable');await call('Network.enable');
    await call('Emulation.setDeviceMetricsOverride',{width,height,deviceScaleFactor:1,mobile:false});
    if(args.includes('--login')){
      const {login}=require('/usr/local/lib/command-dev-login.cjs');
      const auth=await login(targetUrl.origin);
      if(auth.cookie){await call('Network.setCookie',{...auth.cookie,url:auth.origin})}
      if(auth.storageKey){await call('Page.addScriptToEvaluateOnNewDocument',{source:'if(location.origin==='+JSON.stringify(auth.origin)+')localStorage.setItem('+JSON.stringify(auth.storageKey)+','+JSON.stringify(auth.token)+')'})}
    }
    const nav=await call('Page.navigate',{url});if(nav.errorText)throw Error(nav.errorText);
    mainFrame=nav.frameId;
    let page;
    for(let i=0;i<150;i++){
      if(own?.exitCode!=null)throw Error('Chromium exited.');
      const result=await call('Runtime.evaluate',{returnByValue:true,expression:'(()=>({url:location.href,title:document.title,ready:document.readyState==="complete" && !!document.body && document.body.innerText.trim().length>0 && '+(selector?'!!document.querySelector('+JSON.stringify(selector)+')':'true')+' && '+(expected?'document.body.innerText.includes('+JSON.stringify(expected)+')':'true')+'}))()'});
      if(result.exceptionDetails)throw Error('The page assertion could not be evaluated.');
      page=result.result?.value;
      documentStatus=responses.get(mainFrame)||documentStatus;
      if(documentStatus>=400)throw Error('Page returned HTTP '+documentStatus);
      if(page?.ready && page.url!=='about:blank' && documentStatus>=200)break;
      await wait(170);
    }
    if(!page?.ready||!documentStatus)throw Error('The page did not satisfy the requested browser check.');
    if(args.includes('--dump-dom')){console.log((await call('Runtime.evaluate',{expression:'document.documentElement.outerHTML',returnByValue:true})).result.value);return}
    const png=Buffer.from((await call('Page.captureScreenshot',{format:'png',fromSurface:true})).data,'base64');
    const file=path.resolve(output);await fs.mkdir(path.dirname(file),{recursive:true});
    await fs.writeFile(file,png,{mode:0o600});
    const location=new URL(page.url);const proof={url:location.origin+location.pathname,status:documentStatus,title:page.title,width,height,sha256:crypto.createHash('sha256').update(png).digest('hex'),captured_at:new Date().toISOString(),browser:version.Browser};
    if(args.includes('--publish')){
      const cfg=JSON.parse(await fs.readFile('/run/command-memory/memory.json','utf8'));
      let rsp;
      for(let attempt=0;attempt<3;attempt++){
        try {
          rsp=await fetch(cfg.url+'/screenshots',{method:'POST',redirect:'error',headers:{authorization:'Bearer '+cfg.token,'content-type':'image/png','x-image-sha256':proof.sha256},body:png,signal:AbortSignal.timeout(6500)});
          if(rsp.status<500 || attempt===2) break;
        } catch(e){if(attempt===2)throw e}
        await wait(400*(attempt+1));
      }
      if(!rsp.ok)throw Error('PNG saved locally; publishing returned HTTP '+rsp.status);
      proof.evidence=(await rsp.json()).url;
    }
    await fs.writeFile(file+'.json',JSON.stringify(proof,null,2)+'\n',{mode:0o600});
    console.log(JSON.stringify({...proof,file}));
  }finally{ws?.close();if(own){own.kill();if(profile)await fs.rm(profile,{recursive:true,force:true}).catch(()=>{})}}
}
const timeout=setTimeout(()=>{console.error('Browser capture timed out.');process.exit(1)},50000);timeout.unref();
capture().catch(e=>{console.error(e.message||'Browser capture failed');process.exitCode=1});
