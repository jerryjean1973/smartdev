#!/usr/bin/env python3
"""Get a read-only credential for this workspace's registered GitHub repository."""
import os
import re
import sys
from urllib.error import HTTPError, URLError
from command_api import exchange

if len(sys.argv) == 2 and sys.argv[1] == 'get':
    fields = dict(item.rstrip('\n').split('=', 1) for item in sys.stdin if '=' in item)
    target = fields.get('path', '').removesuffix('.git')
    if (fields.get('protocol') == 'https' and fields.get('host') == 'github.com'
            and target and target.casefold() == os.getenv('PROJECT_REPOSITORY','').casefold()):
        try:
            result = exchange({'repository': target}, '/git-credential', timeout=12)
            token = result['token']
            if isinstance(token, str) and re.fullmatch(r'[A-Za-z0-9_]{16,512}', token):
                print('username=x-access-token\npassword='+token)
        except (OSError, ValueError, KeyError, HTTPError, URLError):
            pass
