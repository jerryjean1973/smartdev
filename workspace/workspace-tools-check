#!/usr/bin/env python3
"""Verify an agent's enrolled tools, default organization and capture path."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

def check(*args, timeout=25):
    return subprocess.check_output(args, env={**os.environ,"GIT_TERMINAL_PROMPT":"0"},
                                   timeout=timeout, text=True, stderr=subprocess.DEVNULL)

def main():
    stage="tools"
    try:
        if any(not shutil.which(name) for name in ("wget","curl","chromium","screenshot","git")):
            raise RuntimeError("missing command")
        stage="account"
        account=json.loads(check("workspace-dev-login","coder"))
        if not account["authenticated"] or not account["defaultOrganization"]:
            raise RuntimeError("organization unavailable")
        check("workspace-dev-login")
        origin=account["origin"]
        stage="network"
        check("wget","-qO","/dev/null","-T","8",origin+"/api/v2/buildinfo")
        check("curl","-fsS","--max-time","8",origin+"/api/v2/buildinfo")
        stage="git"
        if "origin" in check("git","remote").splitlines():
            check("git","ls-remote","--exit-code","origin","HEAD",timeout=35)
        stage="browser"
        with tempfile.TemporaryDirectory() as work:
            output=Path(work)/"screen.png"
            receipt=json.loads(check("screenshot",origin+"/api/v2/users/me","--login","--text","smartdev.invalid",
                                     "--out",str(output),timeout=60))
            if receipt["status"]!=200 or not output.exists():
                raise RuntimeError("browser proof unavailable")
    except (KeyError, OSError, RuntimeError, ValueError, subprocess.SubprocessError):
        print(stage)
        return 1
    print("healthy")
    return 0

if __name__=="__main__":
    sys.exit(main())
